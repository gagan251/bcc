/**
 * Core Philosophy: This ruleset enforces a strict security model that separates public
 * content from private user data. The core principle is path-based ownership, where all
 * data specific to a user (like enrollments and test results) is stored in a data tree
 * that only they can access. Publicly-accessible content like courses are readable by
 * anyone, but the lessons and tests within them are restricted to signed-in users.
 *
 * Data Structure:
 * - /users/{userId}/...
 *   - This path contains all private data for a specific user. Access is strictly
 *     limited to the authenticated user whose UID matches the {userId}.
 * - /courses/{courseId}/...
 *   - This path contains course descriptions, which are public. Lessons and tests
 *     within a course are readable by all signed-in users.
 * - /reviews/{reviewId}
 *   - This path stores user-submitted reviews. It is write-only for clients, meaning
 *     anyone can submit a review, but only admins can read them.
 *
 * Key Security Decisions:
 * - User Data Privacy: A user can only access their own document and subcollections
 *   within `/users/{userId}`. User listing is explicitly disabled to protect privacy.
 * - Public Course Listing: The main `/courses` collection is public to allow browsing
 *   by potential customers. Write operations are restricted to admins. Course content
 *   (lessons, tests) is restricted to signed-in users.
 * - Admin-Readable Reviews: The `/reviews` collection allows any client to write
 *   a new document. Read access is restricted to users with an 'admin' role.
 *
 * Denormalization for Authorization:
 * The data model is already well-structured for security rules. By placing user-specific
 * documents like `enrollments` and `testResults` in a subcollection under the user's
 * document, we can use fast, simple path-based ownership rules (`isOwner(userId)`)
 * without needing slow and costly `get()` calls to other documents to verify permissions.
 * The `isAdmin` function uses a `get()` call, which is necessary for role-based access.
 *
 * Structural Segregation:
 * The ruleset leverages the clear separation between the private `/users` collection and
 * the public `/courses` collection. This allows for simple, performant, and secure rules
 * for listing documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the foundation of the user-ownership security model.
     * @param userId The UID of the user to check against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the user has an 'admin' role in their user profile.
     * This requires a document read, which has performance and cost implications.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }


    /**
     * Checks if a document exists and if the requester is the owner.
     * Used for safe update and delete operations.
     * @param userId The UID of the document owner.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // ------------------------------------------------------------------------
    // User Profile Rules
    // ------------------------------------------------------------------------

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get/update/delete) The user {userId} accessing their own document.
     * @allow (read) Admins can read user profiles.
     * @deny (list) Any user attempting to list all user profiles, except admins.
     * @deny (get) A user trying to read another user's profile.
     * @principle A user has sole control over their own profile document. Admins have read access.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId)
                    && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      // ------------------------------------------------------------------------
      // User Subcollection Rules
      // ------------------------------------------------------------------------

      /**
       * @description Controls access to a user's course enrollment records.
       * @path /users/{userId}/enrollments/{enrollmentId}
       * @allow (create/get/list/update/delete) The user {userId} managing their own enrollments.
       * @deny (any) Any user trying to access another user's enrollment records.
       * @principle Restricts access to a user's own data tree using path-based ownership.
       */
      match /enrollments/{enrollmentId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId)
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Controls access to a user's test results.
       * @path /users/{userId}/testResults/{testResultId}
       * @allow (create/get/list/update/delete) The user {userId} managing their own test results.
       * @deny (any) Any user trying to access another user's test results.
       * @principle Restricts access to a user's own data tree using path-based ownership.
       */
      match /testResults/{testResultId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId)
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    // ------------------------------------------------------------------------
    // Public Review Submission
    // ------------------------------------------------------------------------
    /**
     * @description Controls access for submitting and viewing reviews.
     * @path /reviews/{reviewId}
     * @allow (create) Anyone can submit a review with valid data.
     * @allow (read/list) Only users with an 'admin' role can read reviews.
     * @deny (update/delete) All other operations are forbidden from the client.
     * @principle Allows for public feedback submission while protecting data integrity.
     */
    match /reviews/{reviewId} {
        allow read, list: if isAdmin();
        allow update, delete: if false;
        allow create: if request.resource.data.name is string
                       && request.resource.data.rating is number
                       && request.resource.data.feedback is string
                       && request.resource.data.createdAt == request.time;
    }


    // ------------------------------------------------------------------------
    // Public Course Content Rules
    // ------------------------------------------------------------------------

    /**
     * @description Controls access to the top-level courses collection.
     * @path /courses/{courseId}
     * @allow (get/list) Any user can browse the list of available courses.
     * @deny (create/update/delete) Write operations are restricted to admins.
     * @principle Public course data is readable by all, but writes are restricted.
     */
    match /courses/{courseId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();

      /**
       * @description Controls access to lessons within a course.
       * @path /courses/{courseId}/lessons/{lessonId}
       * @allow (get/list) Any authenticated user reading the lessons of a course.
       * @deny (create/update/delete) All write operations are denied.
       * @principle Public data is readable by all signed-in users, but writes are restricted for security.
       */
      match /lessons/{lessonId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      /**
       * @description Controls access to tests within a course.
       * @path /courses/{courseId}/tests/{testId}
       * @allow (get/list) Any authenticated user viewing the tests for a course.
       * @deny (create/update/delete) All write operations are denied.
       * @principle Public data is readable by all signed-in users, but writes are restricted for security.
       */
      match /tests/{testId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }
  }
}
